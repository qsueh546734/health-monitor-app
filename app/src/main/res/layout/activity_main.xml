<?xml version="1.0" encoding="utf-8"?>
<!--
  单 Activity 多页面：顶上一排页面按钮，下面一个 FrameLayout 装 6 个页面，
  同一时刻只显示一个。

  这样做的理由：不用 Fragment（那要 AndroidX，而本项目零依赖），
  而 6 个页面的切换逻辑在 MainActivity 里就是一次循环 setVisibility。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ================= 页面切换 ================= -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button android:id="@+id/tabConnect"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="连接" />
            <Button android:id="@+id/tabControl"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="主控" />
            <Button android:id="@+id/tabHistory"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="历史" />
            <Button android:id="@+id/tabAnalysis" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="分析" />
            <Button android:id="@+id/tabSettings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="设置" />
            <Button android:id="@+id/tabLogin"    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="账号" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ================= 页面容器 ================= -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===== 连接页 ===== -->
        <ScrollView android:id="@+id/pageConnect" android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:text="连接设备" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp"
                    android:text="先用手机 WiFi 连上设备的 HealthMon 热点（密码 12345678），或连同一路由器。IP 见设备 OLED。" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="设备 IP" />
                <EditText android:id="@+id/etIp" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:hint="192.168.4.1" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="端口" />
                <EditText android:id="@+id/etPort" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:hint="8266" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                    <Button android:id="@+id/btnConnect" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="连接" />
                    <Button android:id="@+id/btnDisconnect" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="断开" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
                    <TextView android:id="@+id/tvConnDot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" android:text="● " />
                    <TextView android:id="@+id/tvConnState" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:text="未连接" />
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="12sp"
                    android:text="连不上时依次检查：\n1. 手机是否已连上 HealthMon（或与设备同一路由器）\n2. IP 是否与 OLED 上显示的一致\n3. 设备是否已上电并显示数值\n4. 需要时可在设置页打开模拟器模式，不连设备也能演示" />
            </LinearLayout>
        </ScrollView>

        <!-- ===== 主控页 ===== -->
        <ScrollView android:id="@+id/pageControl" android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/tvSystem" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="16sp" android:text="—" />
                    <TextView android:id="@+id/tvFresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:text="" />
                </LinearLayout>

                <!-- 五张数据卡 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:text="体温" />
                        <TextView android:id="@+id/tvBtValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" android:text="--" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:text="心率" />
                        <TextView android:id="@+id/tvHrValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" android:text="--" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:text="血氧" />
                        <TextView android:id="@+id/tvSpo2Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" android:text="--" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:text="步数" />
                        <TextView android:id="@+id/tvStepsValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" android:text="--" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:text="水位" />
                        <TextView android:id="@+id/tvWaterValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" android:text="--" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 水泵 -->
                <TextView android:id="@+id/tvPumpState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="14sp" android:text="水泵：—" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnPumpOn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="手动开" />
                    <Button android:id="@+id/btnPumpOff" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="手动关" />
                    <Button android:id="@+id/btnPumpAuto" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="恢复自动" />
                </LinearLayout>

                <TextView android:id="@+id/tvStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="12sp" android:text="已收 0 帧 / 丢 0 帧 / 错误行 0" />
            </LinearLayout>
        </ScrollView>

        <!-- ===== 历史页 ===== -->
        <LinearLayout android:id="@+id/pageHistory" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btnChartBt" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="体温" />
                <Button android:id="@+id/btnChartHr" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="心率" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btnRange10"  android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="10 分钟" />
                <Button android:id="@+id/btnRange60"  android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="1 小时" />
                <Button android:id="@+id/btnRangeAll" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="全部" />
            </LinearLayout>

            <com.example.healthmon.ChartView
                android:id="@+id/chart"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp" />

            <TextView android:id="@+id/tvChartCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:text="—" />
        </LinearLayout>

        <!-- ===== 分析页 ===== -->
        <LinearLayout android:id="@+id/pageAnalysis" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btnReanalyze" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="重新分析" />
                <TextView android:id="@+id/tvTokens" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="12sp" android:text="" />
            </LinearLayout>

            <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp">
                <TextView android:id="@+id/tvAiResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:text="进入本页会自动分析最近 10 分钟的数据。" />
            </ScrollView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <EditText android:id="@+id/etAsk" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="继续追问…" android:inputType="text" />
                <Button android:id="@+id/btnAsk" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="发送" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 设置页 ===== -->
        <ScrollView android:id="@+id/pageSettings" android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="16sp" android:text="预警阈值" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <EditText android:id="@+id/etBtHi" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:inputType="numberDecimal" android:hint="体温上限" />
                    <EditText android:id="@+id/etHrHi" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:inputType="number" android:hint="心率上限" />
                    <EditText android:id="@+id/etWLow" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:inputType="number" android:hint="水位下限" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnSendTh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="下发" />
                    <Button android:id="@+id/btnReadTh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="读取当前值" />
                    <Button android:id="@+id/btnClearSteps" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="步数清零" />
                </LinearLayout>
                <TextView android:id="@+id/tvThStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:text="" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="16sp" android:text="模拟器（没有硬件也能演示）" />
                <Button android:id="@+id/btnToggleSim" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="切换模拟器模式" />
                <TextView android:id="@+id/tvSimState" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:text="模拟器：关" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="16sp" android:text="DeepSeek 分析" />
                <EditText android:id="@+id/etAiKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="粘贴 API key" android:inputType="text" />
                <Button android:id="@+id/btnSaveAi" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="保存 API key" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp"
                    android:text="说明：key 存在手机本地，反编译可读。课程项目可接受，正式产品需改为服务端中转。" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="16sp" android:text="个人信息（用于分析）" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <EditText android:id="@+id/etAge" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:inputType="number" android:hint="年龄" />
                    <EditText android:id="@+id/etHeight" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:inputType="numberDecimal" android:hint="身高cm" />
                    <EditText android:id="@+id/etWeight" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:inputType="numberDecimal" android:hint="体重kg" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnGenderM" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="男" />
                    <Button android:id="@+id/btnGenderF" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="女" />
                    <Button android:id="@+id/btnSaveProfile" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:text="保存个人信息" />
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="16sp" android:text="WiFi 配置（让设备连你的热点）" />
                <EditText android:id="@+id/etWifiSsid" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="热点名称（不能含逗号）" android:inputType="text" />
                <EditText android:id="@+id/etWifiPass" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="热点密码" android:inputType="text" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnWifiConnect" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="让设备连这个热点" />
                    <Button android:id="@+id/btnWifiForget" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="忘记网络" />
                </LinearLayout>
                <TextView android:id="@+id/tvWifiStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp"
                    android:text="注意：ESP8266 只支持 2.4GHz 热点，且不支持 WPA3。" />
            </LinearLayout>
        </ScrollView>

        <!-- ===== 账号页 ===== -->
        <ScrollView android:id="@+id/pageLogin" android:layout_width="match_parent" android:layout_height="match_parent">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                <TextView android:id="@+id/tvLoginState" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:text="未登录" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp"
                    android:text="本地账号，仅用于区分使用者。不登录也能正常使用其他所有功能。" />

                <EditText android:id="@+id/etUser" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="用户名" android:inputType="text" />
                <EditText android:id="@+id/etPass" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="密码" android:inputType="textPassword" />
                <EditText android:id="@+id/etPass2" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="再输一次密码（仅注册用）" android:inputType="textPassword" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnLogin" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="登录" />
                    <Button android:id="@+id/btnRegister" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="注册" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
